Patch by Kurt Lust for the LUMI consortium to be able to use a more recent config.guess
downloaded from the Spack gnuconfig fork as that offers a more reliable download location
from which we can install the file in the EasyConfig.
mv easybuild_easyblocks-5.4.2 easybuild-easyblocks-5.4.2
diff -Nau easybuild-easyblocks-5.4.2/easybuild/easyblocks/generic/configuremake.py.orig easybuild-easyblocks-5.4.2/easybuild/easyblocks/generic/configuremake.py
--- easybuild-easyblocks-5.4.2/easybuild/easyblocks/generic/configuremake.py.orig	2026-11-23 15:54:59.000000000 +0200
+++ easybuild-easyblocks-5.4.2/easybuild/easyblocks/generic/configuremake.py	2026-11-23 15:55:47.000000000 +0200
@@ -58,10 +58,10 @@
 AUTOCONF_GENERATED_MSG = b"Generated by GNU Autoconf"
 
 # download location & SHA256 for config.guess script
-CONFIG_GUESS_VERSION = '2023-08-22'
+CONFIG_GUESS_VERSION = '2025-07-10'
 CONFIG_GUESS_URL_STUB = "https://git.savannah.gnu.org/cgit/config.git/plain/config.guess?id="
 CONFIG_GUESS_COMMIT_ID = "28ea239c53a2d5d8800c472bc2452eaa16e37af2"
-CONFIG_GUESS_SHA256 = "ec2577614252326f889df1de97b9a457c03a9a94811048563c211a44496d8ba3"
+CONFIG_GUESS_SHA256 = "50205cf3ec5c7615b17f937a0a57babf4ec5cd0aade3d7b3cccbe5f1bf91a7ef"
 
 
 DEFAULT_BUILD_CMD = 'make'
