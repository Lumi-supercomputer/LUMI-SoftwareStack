easyblock = 'CMakeMake'

local_libzip_version =       '1.11.4'        # https://github.com/nih-at/libzip

local_zlib_version =         '1.3.1'         # https://zlib.net/
local_bzip2_version =        '1.0.8'         # http://www.bzip.org/downloads.html
local_XZ_version =           '5.6.3'         # https://tukaani.org/xz/
local_zstd_version =         '1.5.7'         # https://github.com/facebook/zstd/releases

name =    'libzip'
version = local_libzip_version

homepage = 'https://libzip.org/'

whatis = [
    'Description: libzip is a C library for reading, creating, and modifying zip archives.'
]

description = """
libzip is a C library for reading, creating, and modifying zip archives.
"""

docurls = [
    'Web-based documentation on https://libzip.org/'
]

toolchain = {'name': 'cpeCray', 'version': '25.03'}

sources = [{
    'filename':          SOURCELOWER_TAR_GZ,
    'download_filename': 'v%(version)s.tar.gz',
    'source_urls':       ['https://github.com/nih-at/libzip/archive/']
}]
checksums = ['4844595615e2436e3cf1ed46a1b260fbdaf8b8fa8f2b594e8b5d8162c696b8b2']

builddependencies = [
    ('buildtools', '%(toolchain_version)s', '', True)
]

dependencies = [
    ('zlib',  local_zlib_version),
    ('bzip2', local_bzip2_version),
    ('XZ',    local_XZ_version),
    ('zstd',  local_zstd_version),
]

preconfigopts = 'module unload cray-mpich cray-libsci rocm && '
preinstallopts = pretestopts = prebuildopts = preconfigopts

configopts = [
    '-DBUILD_SHARED_LIBS=OFF',
    '-DBUILD_SHARED_LIBS=ON',
]

postinstallcmds = [
    'mkdir -p %(installdir)s/share/licenses/%(name)s',
    'cd ../%(namelower)s-%(version)s && cp AUTHORS LICENSE NEWS.md README.md SECURITY.md THANKS %(installdir)s/share/licenses/%(name)s',   
]

sanity_check_paths = {
    'files': [
        'bin/zipcmp',
        'bin/zipmerge',
        'bin/ziptool',
        'lib64/libzip.a',
        f'lib64/libzip.{SHLIB_EXT}',
    ],
    'dirs': ['include', 'lib/pkgconfig'],
}

sanity_check_commands = [
    'zipcmp -h',
    'zipmerge -h',
    'ziptool -h',
    'pkg-config --validate libzip',
    f'pkg-config --exact-version={version} libzip'
]

moduleclass = 'lib'